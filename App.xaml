<Application
    x:Class="RemoSystemProfiler.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111214" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#17181B" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#1C1D20" />
                    <SolidColorBrush x:Key="PanelStrongBrush" Color="#222327" />
                    <SolidColorBrush x:Key="PanelSoftBrush" Color="#26282D" />
                    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#3A3D44" />
                    <SolidColorBrush x:Key="ChartBackgroundBrush" Color="#202226" />
                    <SolidColorBrush x:Key="AccentTextBrush" Color="#F4F7FB" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#A7AFBD" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#7E8796" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111214" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#17181B" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#1C1D20" />
                    <SolidColorBrush x:Key="PanelStrongBrush" Color="#222327" />
                    <SolidColorBrush x:Key="PanelSoftBrush" Color="#26282D" />
                    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#3A3D44" />
                    <SolidColorBrush x:Key="ChartBackgroundBrush" Color="#202226" />
                    <SolidColorBrush x:Key="AccentTextBrush" Color="#F4F7FB" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#A7AFBD" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#7E8796" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F7FA" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#EEF2F7" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PanelStrongBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="PanelSoftBrush" Color="#F3F6FA" />
                    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#D1D8E2" />
                    <SolidColorBrush x:Key="ChartBackgroundBrush" Color="#FAFCFF" />
                    <SolidColorBrush x:Key="AccentTextBrush" Color="#111827" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#475467" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#667085" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="BlueBrush" Color="#37B7E8" />
            <SolidColorBrush x:Key="RedBrush" Color="#F97066" />
            <SolidColorBrush x:Key="GreenBrush" Color="#32D583" />
            <SolidColorBrush x:Key="AmberBrush" Color="#FDB022" />
            <SolidColorBrush x:Key="PurpleBrush" Color="#C77DFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
