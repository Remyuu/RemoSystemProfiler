                    <SolidColorBrush x:Key="PanelStrongBrush" Color="#F2F8FAFC" />
                    <SolidColorBrush x:Key="PanelStrongHoverBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="PanelSoftBrush" Color="#EAF3F6FA" />
                    <SolidColorBrush x:Key="PanelSoftHoverBrush" Color="#F6FFFFFF" />
                    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#38B8C2CF" />
                    <SolidColorBrush x:Key="PanelHoverStrokeBrush" Color="#66A6B1C0" />
                    <SolidColorBrush x:Key="ChartBackgroundBrush" Color="#DFFAFCFF" />
                    <SolidColorBrush x:Key="WindowEdgeBrush" Color="#8AD1D8E2" />
                    <SolidColorBrush x:Key="AccentTextBrush" Color="#111827" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#475467" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#667085" />
                    <SolidColorBrush x:Key="StartupOverlayBackgroundBrush" Color="#F5F7FA" />
                    <SolidColorBrush x:Key="StartupOverlayPanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="StartupOverlayStatusBrush" Color="#EEF3F8" />
                    <SolidColorBrush x:Key="StartupOverlayStrokeBrush" Color="#B8C2CF" />
                    <SolidColorBrush x:Key="StartupOverlayTextBrush" Color="#111827" />
                    <SolidColorBrush x:Key="StartupOverlayMutedTextBrush" Color="#475467" />
                    <SolidColorBrush x:Key="StartupOverlayTrackBrush" Color="#D5DCE6" />
                    <SolidColorBrush x:Key="BenchmarkEntryBackgroundBrush" Color="#2EFDB022" />
                    <SolidColorBrush x:Key="BenchmarkEntryHoverBrush" Color="#46FDB022" />
                    <SolidColorBrush x:Key="BenchmarkEntryPressedBrush" Color="#24FDB022" />
                    <SolidColorBrush x:Key="BenchmarkEntryBorderBrush" Color="#80D97706" />
                    <SolidColorBrush x:Key="BenchmarkEntryIconBrush" Color="#B54708" />
                    <SolidColorBrush x:Key="BenchmarkRunBackgroundBrush" Color="#15803D" />
                    <SolidColorBrush x:Key="BenchmarkRunHoverBrush" Color="#166534" />
                    <SolidColorBrush x:Key="BenchmarkRunPressedBrush" Color="#14532D" />
                    <SolidColorBrush x:Key="BenchmarkRunBorderBrush" Color="#0F6B35" />
                    <SolidColorBrush x:Key="BenchmarkRunTextBrush" Color="#FFFFFF" />
                    <LinearGradientBrush x:Key="PanelFadeTopBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#FFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="PanelFadeBottomBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#00FFFFFF" />
                        <GradientStop Offset="1" Color="#FFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SidebarFadeTopBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#EEF2F7" />
                        <GradientStop Offset="1" Color="#00EEF2F7" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SidebarFadeBottomBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#00EEF2F7" />
                        <GradientStop Offset="1" Color="#EEF2F7" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="BlueBrush" Color="#37B7E8" />
            <SolidColorBrush x:Key="RedBrush" Color="#F97066" />
            <SolidColorBrush x:Key="GreenBrush" Color="#32D583" />
            <SolidColorBrush x:Key="AmberBrush" Color="#FDB022" />
            <SolidColorBrush x:Key="PurpleBrush" Color="#C77DFF" />
