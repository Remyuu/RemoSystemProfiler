<Application
    x:Class="RemoSystemProfiler.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#B812161C" />
                    <LinearGradientBrush x:Key="DashboardBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#72111B20" />
                        <GradientStop Offset="0.48" Color="#5413181E" />
                        <GradientStop Offset="1" Color="#6810161C" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="SidebarBrush" Color="#B0171C24" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#D81C222B" />
                    <SolidColorBrush x:Key="PanelHoverBrush" Color="#E0222934" />
                    <SolidColorBrush x:Key="PanelStrongBrush" Color="#E0242B36" />
                    <SolidColorBrush x:Key="PanelStrongHoverBrush" Color="#E82B3441" />
                    <SolidColorBrush x:Key="PanelSoftBrush" Color="#D828303B" />
                    <SolidColorBrush x:Key="PanelSoftHoverBrush" Color="#E0303946" />
                    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#26455060" />
                    <SolidColorBrush x:Key="PanelHoverStrokeBrush" Color="#59455060" />
                    <SolidColorBrush x:Key="ChartBackgroundBrush" Color="#B0202733" />
                    <SolidColorBrush x:Key="WindowEdgeBrush" Color="#60455060" />
                    <SolidColorBrush x:Key="AccentTextBrush" Color="#F6F8FB" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#B4BECC" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#8E9AAC" />
                    <SolidColorBrush x:Key="StartupOverlayBackgroundBrush" Color="#070A0F" />
                    <SolidColorBrush x:Key="StartupOverlayPanelBrush" Color="#151C26" />
                    <SolidColorBrush x:Key="StartupOverlayStatusBrush" Color="#111821" />
                    <SolidColorBrush x:Key="StartupOverlayStrokeBrush" Color="#4B596B" />
                    <SolidColorBrush x:Key="StartupOverlayTextBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="StartupOverlayMutedTextBrush" Color="#C7D7F2" />
                    <SolidColorBrush x:Key="StartupOverlayTrackBrush" Color="#27303C" />
                    <SolidColorBrush x:Key="BenchmarkEntryBackgroundBrush" Color="#343A2A10" />
                    <SolidColorBrush x:Key="BenchmarkEntryHoverBrush" Color="#4A4A3514" />
                    <SolidColorBrush x:Key="BenchmarkEntryPressedBrush" Color="#242D210E" />
                    <SolidColorBrush x:Key="BenchmarkEntryBorderBrush" Color="#8AC88412" />
                    <SolidColorBrush x:Key="BenchmarkEntryIconBrush" Color="#FDB022" />
                    <SolidColorBrush x:Key="BenchmarkRunBackgroundBrush" Color="#15803D" />
                    <SolidColorBrush x:Key="BenchmarkRunHoverBrush" Color="#166534" />
                    <SolidColorBrush x:Key="BenchmarkRunPressedBrush" Color="#14532D" />
                    <SolidColorBrush x:Key="BenchmarkRunBorderBrush" Color="#22C55E" />
                    <SolidColorBrush x:Key="BenchmarkRunTextBrush" Color="#FFFFFF" />
                    <LinearGradientBrush x:Key="PanelFadeTopBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#1C222B" />
                        <GradientStop Offset="1" Color="#001C222B" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="PanelFadeBottomBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#001C222B" />
                        <GradientStop Offset="1" Color="#1C222B" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SidebarFadeTopBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#171C24" />
                        <GradientStop Offset="1" Color="#00171C24" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SidebarFadeBottomBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#00171C24" />
