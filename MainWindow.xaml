<Window
    x:Class="RemoSystemProfiler.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:RemoSystemProfiler"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Remo System Profiler">

    <Grid
        x:Name="Root"
        MinWidth="980"
        MinHeight="640"
        Background="{ThemeResource AppBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="PanelBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="10" />
                <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
            </Style>

            <Style x:Key="LabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
            </Style>

            <Style x:Key="ValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextBrush}" />
            </Style>

            <DataTemplate x:Key="MetricRowTemplate">
                <Border
                    MinHeight="28"
                    Padding="8,4"
                    Background="{ThemeResource PanelSoftBrush}"
                    BorderBrush="{ThemeResource PanelStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock
                            Style="{StaticResource LabelTextStyle}"
                            Text="{Binding Label}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentTextBrush}"
                            Text="{Binding ValueText}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="HardwareOverviewTemplate">
                <Border
                    MinHeight="68"
                    Padding="9,7"
                    Background="{ThemeResource PanelBrush}"
                    BorderBrush="{Binding AccentBrush}"
                    BorderThickness="2,1,1,1"
                    CornerRadius="5">
                    <Grid ColumnDefinitions="66,*" ColumnSpacing="9">
                        <Border
                            Width="62"
                            Height="38"
                            Background="{ThemeResource ChartBackgroundBrush}"
                            BorderBrush="{ThemeResource PanelStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <Grid Margin="4">
                                <Polyline
                                    Points="{Binding SparklinePoints}"
                                    Stroke="{Binding AccentBrush}"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="2" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextBrush}"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextBrush}"
                                    Text="{Binding PrimaryText}" />
                            </Grid>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource MutedTextBrush}"
                                Text="{Binding SecondaryText}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource SubtleTextBrush}"
                                Text="{Binding DetailText}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="CoreTemplate">
                <Border
                    MinWidth="34"
                    MinHeight="34"
                    Margin="0"
                    Padding="0"
                    Background="{ThemeResource ChartBackgroundBrush}"
                    BorderBrush="{ThemeResource PanelStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <Grid>
                        <Viewbox Stretch="Fill">
                            <Canvas Width="120" Height="56">
                                <Rectangle
                                    Width="120"
                                    Height="56"
                                    Fill="{ThemeResource ChartBackgroundBrush}"
                                    RadiusX="2"
                                    RadiusY="2" />
                                <Polyline
                                    Points="{Binding SparklinePoints}"
                                    Stroke="{Binding LoadBrush}"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="2.2" />
                            </Canvas>
                        </Viewbox>
                        <Border
                            Margin="6,4,0,0"
                            Padding="4,1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{ThemeResource PanelStrongBrush}"
                            BorderBrush="{ThemeResource PanelStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="2">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{Binding LoadBrush}"
                                Text="{Binding LoadText}" />
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="SensorGroupTemplate">
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextBrush}"
                                    Text="{Binding Title}" />
                                <Border
                                    Grid.Column="1"
                                    Padding="6,1"
                                    HorizontalAlignment="Right"
                                    Background="{ThemeResource PanelStrongBrush}"
                                    BorderBrush="{ThemeResource PanelStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AmberBrush}"
                                        Text="{Binding StatusText}" />
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="{Binding SummaryOneLabel}" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextBrush}"
                                        Text="{Binding SummaryOneText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="{Binding SummaryTwoLabel}" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextBrush}"
                                        Text="{Binding SummaryTwoText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="{Binding SummaryThreeLabel}" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextBrush}"
                                        Text="{Binding SummaryThreeText}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Expander.Header>
                    <ItemsControl
                        ItemTemplate="{StaticResource MetricRowTemplate}"
                        ItemsSource="{Binding Metrics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Expander>
            </DataTemplate>

            <DataTemplate x:Key="GpuTemplate">
                <Border
                    Padding="2"
                    Background="{ThemeResource PanelSoftBrush}"
                    BorderBrush="{ThemeResource PanelStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="3">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Border
                                        Grid.Column="1"
                                        Padding="5,1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource PanelStrongBrush}"
                                        BorderBrush="{ThemeResource PanelStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource AmberBrush}"
                                            Text="{Binding StatusText}" />
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="Load" />
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextBrush}"
                                            Text="{Binding LoadText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="Temp" />
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource RedBrush}"
                                            Text="{Binding TemperatureText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="Power" />
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextBrush}"
                                            Text="{Binding PowerText}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Expander.Header>
                        <StackPanel Spacing="5">
                            <ItemsControl
                                ItemTemplate="{StaticResource MetricRowTemplate}"
                                ItemsSource="{Binding PowerSensors}" />
                            <ItemsControl
                                ItemTemplate="{StaticResource MetricRowTemplate}"
                                ItemsSource="{Binding TemperatureSensors}" />
                            <ItemsControl
                                ItemTemplate="{StaticResource MetricRowTemplate}"
                                ItemsSource="{Binding MemorySensors}" />
                        </StackPanel>
                    </Expander>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="StorageTemplate">
                <Border
                    Padding="4"
                    Background="{ThemeResource PanelSoftBrush}"
                    BorderBrush="{ThemeResource PanelStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextBrush}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextBrush}"
                                    Text="{Binding UsageText}" />
                                <Border
                                    Grid.Column="2"
                                    Padding="5,1"
                                    HorizontalAlignment="Right"
                                    Background="{ThemeResource PanelStrongBrush}"
                                    BorderBrush="{ThemeResource PanelStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AmberBrush}"
                                        Text="{Binding StatusText}" />
                                </Border>
                            </Grid>
                        </Expander.Header>
                        <ItemsControl
                            ItemTemplate="{StaticResource MetricRowTemplate}"
                            ItemsSource="{Binding Metrics}" />
                    </Expander>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid ColumnDefinitions="260,*">
            <Border
                Background="{ThemeResource SidebarBrush}"
                BorderBrush="{ThemeResource PanelStrokeBrush}"
                BorderThickness="0,0,1,0">
                <Grid Padding="12,10" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="9">
                    <Grid>
                        <StackPanel Spacing="1">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextBrush}"
                                Text="Performance" />
                            <TextBlock
                                x:Name="HardwareSummaryText"
                                FontSize="12"
                                Foreground="{ThemeResource SubtleTextBrush}"
                                Text="Waiting for hardware sensors"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                            <Ellipse
                                x:Name="StatusDot"
                                Width="8"
                                Height="8"
                                Margin="0,2,0,0"
                                VerticalAlignment="Top"
                                Fill="Orange" />
                            <TextBlock
                                x:Name="StatusText"
                                Grid.Column="1"
                                FontSize="12"
                                Foreground="{ThemeResource MutedTextBrush}"
                                Text="Waiting for sensors"
                                TextWrapping="Wrap"
                                MaxLines="3" />
                            <HyperlinkButton
                                x:Name="PawnIoDownloadLink"
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="0"
                                Content="Download PawnIO"
                                FontSize="12"
                                NavigateUri="https://pawnio.eu/"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl
                            x:Name="HardwareOverviewList"
                            ItemTemplate="{StaticResource HardwareOverviewTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Button
                            x:Name="SettingsButton"
                            Width="36"
                            Height="32"
                            Padding="0"
                            ToolTipService.ToolTip="Settings">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Glyph="&#xE713;" />
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedLeft">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="14" />
                                            <Setter Property="MinWidth" Value="240" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel Spacing="12">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextBrush}"
                                            Text="Display settings" />

                                        <StackPanel Spacing="5">
                                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="Chart range" />
                                            <ComboBox
                                                x:Name="ChartRangePicker"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="ChartRangePicker_SelectionChanged">
                                                <ComboBoxItem Content="10 seconds" Tag="10" />
                                                <ComboBoxItem Content="30 seconds" Tag="30" />
                                                <ComboBoxItem Content="1 minute" Tag="60" />
                                                <ComboBoxItem Content="5 minutes" Tag="300" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Spacing="5">
                                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="Update interval" />
                                            <ComboBox
                                                x:Name="UpdateIntervalPicker"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="UpdateIntervalPicker_SelectionChanged">
                                                <ComboBoxItem Content="0.5 seconds" Tag="0.5" />
                                                <ComboBoxItem Content="1 second" Tag="1" />
                                                <ComboBoxItem Content="2 seconds" Tag="2" />
                                                <ComboBoxItem Content="5 seconds" Tag="5" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Spacing="5">
                                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="Theme" />
                                            <ComboBox
                                                x:Name="ThemePicker"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="ThemePicker_SelectionChanged">
                                                <ComboBoxItem Content="System" />
                                                <ComboBoxItem Content="Light" />
                                                <ComboBoxItem Content="Dark" />
                                            </ComboBox>
                                        </StackPanel>

                                        <Border
                                            Height="1"
                                            Margin="0,2"
                                            Background="{ThemeResource PanelStrokeBrush}" />

                                        <Expander
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Header="About">
                                            <StackPanel Padding="0,8,0,0" Spacing="8">
                                                <StackPanel Spacing="1">
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource AccentTextBrush}"
                                                        Text="Remo System Profiler" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource SubtleTextBrush}"
                                                        Text="WinUI 3 hardware monitor" />
                                                </StackPanel>

                                                <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto" RowSpacing="3">
                                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Website" />
                                                    <HyperlinkButton
                                                        Grid.Column="1"
                                                        Padding="0"
                                                        Content="remoooo.com"
                                                        NavigateUri="https://remoooo.com" />
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Style="{StaticResource LabelTextStyle}"
                                                        Text="GitHub" />
                                                    <HyperlinkButton
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Padding="0"
                                                        Content="github.com/Remyuu"
                                                        NavigateUri="https://github.com/Remyuu" />
                                                </Grid>

                                                <StackPanel Spacing="4">
                                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Open-source notices" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource MutedTextBrush}"
                                                        Text="Built with WinUI 3, Windows App SDK, and LibreHardwareMonitor."
                                                        TextWrapping="WrapWholeWords" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource SubtleTextBrush}"
                                                        Text="Third-party components retain their original licenses."
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="0">
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource SubtleTextBrush}"
                                Text="Updated" />
                            <TextBlock
                                x:Name="UpdatedText"
                                HorizontalAlignment="Right"
                                FontSize="11"
                                Foreground="{ThemeResource SubtleTextBrush}"
                                Text="--:--:--" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid
                Grid.Column="1"
                Padding="14,8,14,10"
                RowDefinitions="Auto,2*,3*"
                RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="0">
                        <TextBlock
                            FontSize="34"
                            FontWeight="SemiLight"
                            Foreground="{ThemeResource AccentTextBrush}"
                            Text="CPU" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource SubtleTextBrush}"
                            Text="Configurable live utilization history and package sensors" />
                    </StackPanel>
                    <TextBlock
                        x:Name="CpuNameText"
                        Grid.Column="1"
                        MaxWidth="430"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="19"
                        Foreground="{ThemeResource AccentTextBrush}"
                        Text="--"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <Border
                    Grid.Row="1"
                    MinHeight="148"
                    Style="{StaticResource PanelBorderStyle}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="7">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Style="{StaticResource LabelTextStyle}"
                                Text="Logical processors" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource LabelTextStyle}"
                                Text="100%" />
                        </Grid>
                        <ItemsControl
                            x:Name="CpuCoreList"
                            Grid.Row="1"
                            ItemTemplate="{StaticResource CoreTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:CoreTopologyPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Grid
                    Grid.Row="2"
                    MinHeight="260"
                    ColumnDefinitions="25*,35*,40*"
                    ColumnSpacing="9">
                    <Grid RowDefinitions="Auto,*" RowSpacing="7">
                        <Border Style="{StaticResource PanelBorderStyle}">
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="Utilization" />
                                        <TextBlock x:Name="CpuLoadSummaryText" Style="{StaticResource ValueTextStyle}" Text="--" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="Speed" />
                                        <TextBlock x:Name="ClockText" Style="{StaticResource ValueTextStyle}" Text="--" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="Package power" />
                                        <TextBlock x:Name="CpuPackagePowerText" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextBrush}" Text="--" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="Peak temp" />
                                        <TextBlock x:Name="CpuPeakTempText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource RedBrush}" Text="--" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="Cores / threads" />
                                        <TextBlock x:Name="CoreCountText" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextBrush}" Text="--" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextBrush}" Text="Memory" />
                                        <TextBlock x:Name="MemoryUsageText" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextBrush}" Text="--" />
                                    </Grid>
                                    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="5">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock x:Name="MemoryCapacityText" Style="{StaticResource LabelTextStyle}" Text="--" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="MemoryTempText" Grid.Column="1" FontSize="12" Foreground="{StaticResource RedBrush}" Text="--" />
                                        </Grid>
                                        <ScrollViewer
                                            Grid.Row="1"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Hidden">
                                            <ItemsControl x:Name="MemoryMetricList" ItemTemplate="{StaticResource MetricRowTemplate}" />
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Border>
                    </Grid>

                    <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                        <Grid RowDefinitions="Auto,*" RowSpacing="6">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextBrush}" Text="CPU sensors" />
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Hidden">
                                <ItemsControl
                                    x:Name="CpuSensorGroupList"
                                    ItemTemplate="{StaticResource SensorGroupTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2" RowDefinitions="11*,9*" RowSpacing="7">
                        <Border Style="{StaticResource PanelBorderStyle}">
                            <Grid RowDefinitions="Auto,*" RowSpacing="6">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextBrush}" Text="GPU devices" />
                                <ListView
                                    x:Name="GpuList"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemTemplate="{StaticResource GpuTemplate}"
                                    SelectionMode="None"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                            <Grid RowDefinitions="Auto,*" RowSpacing="6">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextBrush}" Text="Storage devices" />
                                <ListView
                                    x:Name="StorageList"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemTemplate="{StaticResource StorageTemplate}"
                                    SelectionMode="None"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border
            x:Name="StartupOverlay"
            Canvas.ZIndex="10"
            Background="#E6111214">
            <Grid Padding="28">
                <StackPanel
                    Width="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <Grid
                        Width="108"
                        Height="108"
                        HorizontalAlignment="Center">
                        <Ellipse
                            Fill="#3326282D"
                            Stroke="{ThemeResource PanelStrokeBrush}"
                            StrokeThickness="1" />
                        <ProgressRing
                            Width="68"
                            Height="68"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource BlueBrush}"
                            IsActive="True" />
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="28"
                            FontWeight="SemiLight"
                            Foreground="{ThemeResource AccentTextBrush}"
                            MaxWidth="560"
                            Text="Connecting to hardware backend"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource MutedTextBrush}"
                            MaxWidth="520"
                            Text="Initializing LibreHardwareMonitor and enumerating devices"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <Border
                        Width="440"
                        HorizontalAlignment="Center"
                        Padding="12,9"
                        Background="{ThemeResource PanelBrush}"
                        BorderBrush="{ThemeResource PanelStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                            <Ellipse
                                Width="8"
                                Height="8"
                                Margin="0,2,0,0"
                                VerticalAlignment="Top"
                                Fill="{StaticResource AmberBrush}" />
                            <TextBlock
                                x:Name="StartupStatusText"
                                Grid.Column="1"
                                FontSize="12"
                                Foreground="{ThemeResource MutedTextBrush}"
                                Text="Opening sensor backend"
                                TextWrapping="WrapWholeWords" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
