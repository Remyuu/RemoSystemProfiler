<Window
    x:Class="RemoSystemProfiler.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Remo System Profiler">

    <Grid
        x:Name="Root"
        MinWidth="960"
        MinHeight="680">
        <Grid.Resources>
            <SolidColorBrush x:Key="PanelBrush" Color="#F7FAFC" />
            <SolidColorBrush x:Key="PanelStrongBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PanelStrokeBrush" Color="#22101823" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#101823" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#667085" />
            <SolidColorBrush x:Key="BlueBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="RedBrush" Color="#D92D20" />
            <SolidColorBrush x:Key="GreenBrush" Color="#079455" />
            <SolidColorBrush x:Key="AmberBrush" Color="#D18B00" />

            <DataTemplate x:Key="MetricRowTemplate">
                <Border
                    MinHeight="34"
                    Padding="10,7"
                    Background="#F4F7FA"
                    BorderBrush="#12101823"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="{Binding Label}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentTextBrush}"
                            Text="{Binding ValueText}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F6F8FB" Offset="0" />
                <GradientStop Color="#EEF4F7" Offset="0.45" />
                <GradientStop Color="#F7F1EA" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                Margin="20"
                RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Padding="16,14"
                    Background="#F3FFFFFF"
                    BorderBrush="{StaticResource PanelStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border
                                    Width="34"
                                    Height="34"
                                    Background="#101823"
                                    CornerRadius="7">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="RSP" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Text="Remo System Profiler" />
                                    <TextBlock
                                        x:Name="HardwareSummaryText"
                                        FontSize="12"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="Waiting for hardware sensors" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse
                                    x:Name="StatusDot"
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="Orange" />
                                <TextBlock
                                    x:Name="StatusText"
                                    MaxWidth="650"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="Waiting for sensors"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Spacing="8">
                            <ComboBox
                                x:Name="ThemePicker"
                                Width="116"
                                HorizontalAlignment="Right"
                                SelectionChanged="ThemePicker_SelectionChanged">
                                <ComboBoxItem Content="System" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                            <TextBlock
                                x:Name="UpdatedText"
                                HorizontalAlignment="Right"
                                FontSize="12"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="--:--:--" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="12">
                    <Border
                        Padding="14"
                        Background="{StaticResource PanelStrongBrush}"
                        BorderBrush="{StaticResource PanelStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BlueBrush}"
                                Text="CPU PACKAGE" />
                            <TextBlock
                                x:Name="CpuPackagePowerText"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AccentTextBrush}"
                                Text="--" />
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="Peak temp" />
                                    <TextBlock
                                        x:Name="CpuPeakTempText"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource RedBrush}"
                                        Text="--" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="Load" />
                                    <TextBlock
                                        x:Name="CpuLoadSummaryText"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Text="--" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="14"
                        Background="{StaticResource PanelStrongBrush}"
                        BorderBrush="{StaticResource PanelStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource GreenBrush}"
                                Text="MEMORY" />
                            <TextBlock
                                x:Name="MemoryUsageText"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AccentTextBrush}"
                                Text="--" />
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="Temperature" />
                                    <TextBlock
                                        x:Name="MemoryTempText"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource RedBrush}"
                                        Text="--" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="Data" />
                                    <TextBlock
                                        x:Name="MemoryCapacityText"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Text="--"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Padding="14"
                        Background="{StaticResource PanelStrongBrush}"
                        BorderBrush="{StaticResource PanelStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AmberBrush}"
                                Text="GPU" />
                            <TextBlock
                                x:Name="GpuCountText"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AccentTextBrush}"
                                Text="--" />
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="Peak temp" />
                                    <TextBlock
                                        x:Name="GpuPeakTempText"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource RedBrush}"
                                        Text="--" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="Power" />
                                    <TextBlock
                                        x:Name="GpuPowerText"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Text="--" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="3"
                        Padding="14"
                        Background="{StaticResource PanelStrongBrush}"
                        BorderBrush="{StaticResource PanelStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BlueBrush}"
                                Text="STORAGE" />
                            <TextBlock
                                x:Name="StorageCountText"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AccentTextBrush}"
                                Text="--" />
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="Peak temp" />
                                    <TextBlock
                                        x:Name="StoragePeakTempText"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource RedBrush}"
                                        Text="--" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="Read / write" />
                                    <TextBlock
                                        x:Name="StorageIoText"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Text="--"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid
                    Grid.Row="2"
                    ColumnDefinitions="1.16*,0.84*"
                    ColumnSpacing="14">
                    <StackPanel Spacing="14">
                        <Border
                            Padding="14"
                            Background="{StaticResource PanelStrongBrush}"
                            BorderBrush="{StaticResource PanelStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource AccentTextBrush}"
                                            Text="CPU" />
                                        <TextBlock
                                            x:Name="CpuNameText"
                                            FontSize="12"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            Text="--"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="12">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Text="Cores" />
                                            <TextBlock
                                                x:Name="CoreCountText"
                                                HorizontalAlignment="Right"
                                                FontWeight="SemiBold"
                                                Text="--" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Text="Clock" />
                                            <TextBlock
                                                x:Name="ClockText"
                                                HorizontalAlignment="Right"
                                                FontWeight="SemiBold"
                                                Text="--" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            Text="Temperature sensors" />
                                        <ItemsControl
                                            x:Name="CpuTemperatureList"
                                            ItemTemplate="{StaticResource MetricRowTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            Text="Power sensors" />
                                        <ItemsControl
                                            x:Name="CpuPowerList"
                                            ItemTemplate="{StaticResource MetricRowTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2" Spacing="8">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="Per-core load, temperature, and power" />
                                    <ListView
                                        x:Name="CpuCoreList"
                                        MaxHeight="310"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsItemClickEnabled="False"
                                        SelectionMode="None"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,6" />
                                                <Setter Property="MinHeight" Value="48" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    MinHeight="48"
                                                    Padding="10,7"
                                                    Background="#F4F7FA"
                                                    BorderBrush="#12101823"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                    <Grid
                                                        ColumnDefinitions="82,*,76,72"
                                                        ColumnSpacing="10">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource AccentTextBrush}"
                                                            Text="{Binding Name}" />
                                                        <ProgressBar
                                                            Grid.Column="1"
                                                            Height="7"
                                                            Maximum="100"
                                                            Value="{Binding LoadPercent}"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource BlueBrush}" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource RedBrush}"
                                                            Text="{Binding TemperatureText}" />
                                                        <StackPanel
                                                            Grid.Column="3"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Spacing="1">
                                                            <TextBlock
                                                                HorizontalAlignment="Right"
                                                                FontSize="12"
                                                                Foreground="{StaticResource MutedTextBrush}"
                                                                Text="{Binding LoadText}" />
                                                            <TextBlock
                                                                HorizontalAlignment="Right"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource AccentTextBrush}"
                                                                Text="{Binding PowerText}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Padding="14"
                            Background="{StaticResource PanelStrongBrush}"
                            BorderBrush="{StaticResource PanelStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Text="Memory" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="Usage, capacity, and DIMM temperature sensors when exposed" />
                                </StackPanel>
                                <ItemsControl
                                    x:Name="MemoryMetricList"
                                    Grid.Row="1"
                                    ItemTemplate="{StaticResource MetricRowTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="14">
                        <Border
                            Padding="14"
                            Background="{StaticResource PanelStrongBrush}"
                            BorderBrush="{StaticResource PanelStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Text="GPU Devices" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="Power, temperature, VRAM usage, and VRAM temperature" />
                                </StackPanel>

                                <ListView
                                    x:Name="GpuList"
                                    Grid.Row="1"
                                    MaxHeight="360"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsItemClickEnabled="False"
                                    SelectionMode="None"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="12"
                                                Background="#F4F7FA"
                                                BorderBrush="#12101823"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <StackPanel Spacing="10">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource AccentTextBrush}"
                                                                Text="{Binding Name}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{StaticResource MutedTextBrush}"
                                                                Text="{Binding SensorCountText}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock
                                                                HorizontalAlignment="Right"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource RedBrush}"
                                                                Text="{Binding TemperatureText}" />
                                                            <TextBlock
                                                                HorizontalAlignment="Right"
                                                                FontSize="12"
                                                                Foreground="{StaticResource MutedTextBrush}"
                                                                Text="{Binding PowerText}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource MutedTextBrush}"
                                                                Text="POWER" />
                                                            <ItemsControl
                                                                ItemsSource="{Binding PowerSensors}"
                                                                ItemTemplate="{StaticResource MetricRowTemplate}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="6">
                                                            <TextBlock
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource MutedTextBrush}"
                                                                Text="TEMP" />
                                                            <ItemsControl
                                                                ItemsSource="{Binding TemperatureSensors}"
                                                                ItemTemplate="{StaticResource MetricRowTemplate}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Spacing="6">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource MutedTextBrush}"
                                                            Text="VRAM" />
                                                        <ItemsControl
                                                            ItemsSource="{Binding MemorySensors}"
                                                            ItemTemplate="{StaticResource MetricRowTemplate}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <Border
                            Padding="14"
                            Background="{StaticResource PanelStrongBrush}"
                            BorderBrush="{StaticResource PanelStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Text="Storage Devices" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="Every exposed disk with usage, temperature, and read/write throughput" />
                                </StackPanel>

                                <ListView
                                    x:Name="StorageList"
                                    Grid.Row="1"
                                    MaxHeight="360"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsItemClickEnabled="False"
                                    SelectionMode="None"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="12"
                                                Background="#F4F7FA"
                                                BorderBrush="#12101823"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <StackPanel Spacing="10">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource AccentTextBrush}"
                                                                Text="{Binding Name}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{StaticResource MutedTextBrush}"
                                                                Text="{Binding SensorCountText}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock
                                                                HorizontalAlignment="Right"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource RedBrush}"
                                                                Text="{Binding TemperatureText}" />
                                                            <TextBlock
                                                                HorizontalAlignment="Right"
                                                                FontSize="12"
                                                                Foreground="{StaticResource MutedTextBrush}"
                                                                Text="{Binding ReadWriteText}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <ItemsControl
                                                        ItemsSource="{Binding Metrics}"
                                                        ItemTemplate="{StaticResource MetricRowTemplate}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
