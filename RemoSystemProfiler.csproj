<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>RemoSystemProfiler</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>cat_icon_optimized.ico</ApplicationIcon>
    <PackageIcon>cropped-New_HeadIcon.jpg</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="RemoSystemProfiler.Core\**\*.cs" />
    <Compile Remove="RemoSystemProfiler.Backends.Windows\**\*.cs" />
    <EmbeddedResource Remove="RemoSystemProfiler.Core\**\*" />
    <EmbeddedResource Remove="RemoSystemProfiler.Backends.Windows\**\*" />
    <None Remove="RemoSystemProfiler.Core\**\*" />
    <None Remove="RemoSystemProfiler.Backends.Windows\**\*" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="cat_icon_optimized.ico" />
    <AvaloniaResource Include="cropped-New_HeadIcon.jpg" />
  </ItemGroup>

  <ItemGroup>
    <None Include="cropped-New_HeadIcon.jpg">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="RemoSystemProfiler.Backends.Windows\RemoSystemProfiler.Backends.Windows.csproj" />
    <ProjectReference Include="RemoSystemProfiler.Core\RemoSystemProfiler.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
